# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
*.egg

# Local-only artifacts — not part of the tool, not used by source or CI
node_modules/
segments/
concat.txt
package.json
package-lock.json

# Sensitive owner-supplied material — never commit real data or questionnaires
OWNER/questionnaires/
OWNER/real-data/
out/
.coverage

# Node: dev-only local test harness (playwright is not imported by any tracked
# source — it is used ad-hoc for local browser smoke tests). Keep the manifests
# local; add a tracked test package with its own manifest when that tooling
# becomes part of the repo (then git rm the local copies and re-add).
package.json
package-lock.json
